APPLICATIONICONNAME ID 1000 "NioLibTest"
FORM ID 1000 AT (0 0 160 160)
USABLE
BEGIN
    TITLE "NioLib foundation"
    BUTTON "Run" ID 1001 AT (4 139 38 16) USABLE FRAME
    BUTTON "Network" ID 1006 AT (46 139 53 16) USABLE FRAME
    BUTTON "Config" ID 1007 AT (103 139 53 16) USABLE FRAME
END
FORM ID 1002 AT (0 0 160 160)
USABLE
BEGIN
    TITLE "NioLib networking"
    BUTTON "FileRead" ID 1018 AT (4 122 72 14) USABLE FRAME
    BUTTON "FileWrite" ID 1019 AT (82 122 74 14) USABLE FRAME
    BUTTON "Probe" ID 1003 AT (4 139 44 16) USABLE FRAME
    BUTTON "Run" ID 1004 AT (56 139 44 16) USABLE FRAME
    BUTTON "Back" ID 1005 AT (108 139 44 16) USABLE FRAME
END

FORM ID 1020 AT (0 0 160 160) USABLE
BEGIN
    TITLE "NioLib FileRead speed"
    LABEL "Fixture URI:" ID 1024 AT (2 17) USABLE
    FIELD ID 1021 AT (2 29 156 28) EDITABLE UNDERLINED MAXCHARS 192 USABLE
    GRAFFITISTATEINDICATOR AT (146 17)
    BUTTON "Run" ID 1022 AT (4 139 46 16) USABLE FRAME
    BUTTON "Details" ID 1026 AT (55 139 50 16) USABLE FRAME
    BUTTON "Back" ID 1023 AT (110 139 46 16) USABLE FRAME
END

FORM ID 1030 AT (0 0 160 160) USABLE
BEGIN
    TITLE "NioLib FileWrite speed"
    LABEL "Destination URI:" ID 1035 AT (2 17) USABLE
    FIELD ID 1031 AT (2 29 156 28) EDITABLE UNDERLINED MAXCHARS 192 USABLE
    GRAFFITISTATEINDICATOR AT (146 17)
    BUTTON "Write" ID 1032 AT (4 139 46 16) USABLE FRAME
    BUTTON "Details" ID 1034 AT (55 139 50 16) USABLE FRAME
    BUTTON "Back" ID 1033 AT (110 139 46 16) USABLE FRAME
END

ALERT ID 1027 INFORMATION
BEGIN
    TITLE "FileRead details"
    MESSAGE "^1\n^2\n^3"
    BUTTONS "OK"
END
ALERT ID 1037 INFORMATION
BEGIN
    TITLE "FileWrite details"
    MESSAGE "^1\n^2\n^3"
    BUTTONS "OK"
END
ALERT ID 1036 CONFIRMATION
BEGIN
    TITLE "Overwrite test file?"
    MESSAGE "The selected destination will be created or overwritten with 64 KiB of test data, then read back. Use a disposable file."
    BUTTONS "Write" "Cancel"
END

FORM ID 1010 AT (0 0 160 160) USABLE
BEGIN
    TITLE "NioLib transport"
    BUTTON "CS1" ID 1012 AT (4 104 42 14) USABLE FRAME
    BUTTON "Serial" ID 1013 AT (50 104 48 14) USABLE FRAME
    BUTTON "Baud" ID 1014 AT (102 104 54 14) USABLE FRAME
    BUTTON "Save" ID 1015 AT (4 122 42 14) USABLE FRAME
    BUTTON "Default" ID 1016 AT (50 122 48 14) USABLE FRAME
    BUTTON "Flow" ID 1017 AT (102 122 54 14) USABLE FRAME
    BUTTON "Back" ID 1011 AT (55 141 50 14) USABLE FRAME
END
